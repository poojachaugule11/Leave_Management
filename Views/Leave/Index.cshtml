@model LeaveListViewModel
@{
    ViewData["Title"] = "Leave requests";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
    <h1 class="h3 m-0">Leave requests</h1>
    <a class="btn btn-primary" asp-action="Apply">Apply leave</a>
</div>

<form method="get" asp-action="Index" class="filter-bar row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label" for="search">Employee name</label>
        <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="leaveTypeId">Leave type</label>
        <select id="leaveTypeId" name="leaveTypeId" class="form-select"
                asp-items="@(new SelectList(Model.LeaveTypes, "Value", "Text", Model.LeaveTypeId))">
            <option value="">All leave types</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="status">Status</label>
        <select id="status" name="status" class="form-select"
                asp-items="@(new SelectList(Model.Statuses, "Value", "Text", Model.Status))">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-dark flex-fill">Filter</button>
        <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Clear</a>
    </div>
</form>

<div class="table-responsive leave-table">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Employee name</th>
                <th>Leave type</th>
                <th>From date</th>
                <th>To date</th>
                <th class="text-end">Days</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Requests.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-5">
                    No leave requests found. <a asp-action="Apply">Apply for leave</a> to create one.
                </td>
            </tr>
        }
        @foreach (var r in Model.Requests)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@r.Employee?.EmployeeName</div>
                    <div class="small text-muted text-truncate reason" title="@r.Reason">@r.Reason</div>
                </td>
                <td>@r.LeaveType?.LeaveTypeName</td>
                <td>@r.FromDate.ToString("dd MMM yyyy")</td>
                <td>@r.ToDate.ToString("dd MMM yyyy")</td>
                <td class="text-end">@r.NumberOfDays</td>
                <td><span class="status status-@r.Status.ToLower()">@r.Status</span></td>
                <td class="text-end">
                @if (r.Status == LeaveStatus.Pending)
                {
                    <div class="d-inline-flex gap-1">
                        <form asp-action="Approve" asp-route-id="@r.LeaveRequestId" method="post">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@r.LeaveRequestId" method="post"
                              onsubmit="return confirm('Reject this leave request?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </div>
                }
                else
                {
                    <span class="text-muted small">Closed</span>
                }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
